---
// Template for a bilingual academic paper project page
// Copy this file to src/pages/<project>/[lang]/index.astro
// and adjust content for your specific paper.
//
// Usage:
//   1. Copy to src/pages/<project>/[lang]/index.astro
//   2. Replace paper-specific content (title, authors, abstract, etc.)
//   3. Add project-specific images to public/<project>/
//   4. Create redirect page at src/pages/<project>/index.astro

import { Image } from 'astro:assets';
import Layout from '../../../layouts/ProjectLayout.astro';
import { createTranslator } from '../../../lib/i18n';

// ---------------------------------------------------------------------------
// Paper metadata — adjust per project
// ---------------------------------------------------------------------------
const PAPER = {
  title: 'Your Paper Title Here',
  venue: 'CVPR 2026',
  venueShort: 'CVPR',
  year: 2026,
  arxivId: 'XXXX.XXXXX',
  codeUrl: 'https://github.com/username/repo',
  projectUrl: '', // leave empty if same as this page
  teaserImage: '/your-project/teaser.jpg',
  authors: [
    { name: 'First Author', url: 'https://author1.website', affiliation: 'Institution 1' },
    { name: 'Second Author', url: 'https://author2.website', affiliation: 'Institution 2' },
    { name: 'Corresponding Author', url: 'https://corresponding.website', affiliation: 'Institution 1', isCorresponding: true },
  ],
  bibtex: `@inproceedings{yourkey2026,
  title={Your Paper Title Here},
  author={Author, First and Author, Second and Author, Corresponding},
  booktitle={Proceedings of the IEEE/CVF Conference on Computer Vision and Pattern Recognition (CVPR)},
  year={2026}
}`,
};

// ---------------------------------------------------------------------------
// i18n content — add keys to en.json and zh.json
// ---------------------------------------------------------------------------
const CONTENT = {
  en: {
    abstract: 'Write your abstract here in English. Explain the problem, your approach, and key results in 150-250 words.',
    motivation: '## Motivation\\n\\nExplain why this problem matters. What is the real-world impact?',
    method: '## Method\\n\\nDescribe your architecture and key innovations. Use diagrams and formulas.',
    results: '## Results\\n\\nPresent quantitative comparisons and qualitative visualizations.',
    bibtexTitle: 'BibTeX',
    copyButton: 'Copy',
    copiedButton: 'Copied!',
    linksTitle: 'Links',
    arxivLabel: 'arXiv',
    codeLabel: 'Code',
    projectLabel: 'Project Page',
  },
  zh: {
    abstract: '在此处撰写中文摘要。用150-250字说明问题、方法和关键结果。',
    motivation: '## 研究动机\\n\\n解释为什么这个问题重要。实际应用价值是什么？',
    method: '## 方法\\n\\n描述你的架构和核心创新。使用图表和公式。',
    results: '## 实验结果\\n\\n展示定量对比和定性可视化。',
    bibtexTitle: 'BibTeX',
    copyButton: '复制',
    copiedButton: '已复制！',
    linksTitle: '相关链接',
    arxivLabel: 'arXiv',
    codeLabel: '代码',
    projectLabel: '项目页面',
  },
};

// ---------------------------------------------------------------------------
// Route handling
// ---------------------------------------------------------------------------
const { lang } = Astro.params;
const t = createTranslator(lang === 'en' ? 'en' : 'zh');
const content = CONTENT[lang === 'en' ? 'en' : 'zh'];
const pageTitle = `${PAPER.title} — ${PAPER.venue}`;
const canonicalUrl = new URL(Astro.url.pathname, Astro.site).toString();
---

<Layout
  title={pageTitle}
  description={content.abstract.slice(0, 160)}
  lang={lang}
  canonical={canonicalUrl}
>
  <!-- Hero Section -->
  <section class="hero">
    <div class="venue-badge">{PAPER.venue}</div>
    <h1 class="paper-title">{PAPER.title}</h1>

    <div class="authors">
      {PAPER.authors.map((author, i) => (
        <span class="author">
          <a href={author.url} target="_blank" rel="noopener">
            {author.name}
          </a>
          <sup>{author.affiliation}</sup>
          {author.isCorresponding && <span class="corresponding">*</span>}
          {i < PAPER.authors.length - 1 && <span class="sep">,&nbsp;</span>}
        </span>
      ))}
    </div>

    <div class="affiliations">
      <!-- De-duplicate affiliations -->
      {[...new Set(PAPER.authors.map(a => a.affiliation))].map((aff, i) => (
        <span key={aff}><sup>{i + 1}</sup>{aff}{i < [...new Set(PAPER.authors.map(a => a.affiliation))].length - 1 ? ' · ' : ''}</span>
      ))}
    </div>

    <Image
      src={PAPER.teaserImage}
      alt={`${PAPER.title} teaser figure`}
      width={1200}
      height={400}
      loading="eager"
      decoding="sync"
      class="teaser-image"
    />
  </section>

  <!-- Abstract Section -->
  <section class="abstract" id="abstract">
    <h2>{t('project.abstract')}</h2>
    <p set:html={content.abstract.replace(/\n/g, '<br/>')} />
  </section>

  <!-- Motivation Section -->
  <section class="motivation" id="motivation">
    <div set:html={content.motivation.replace(/\n/g, '<br/>')} />
  </section>

  <!-- Method Section -->
  <section class="method" id="method">
    <div set:html={content.method.replace(/\n/g, '<br/>')} />
  </section>

  <!-- Results Section -->
  <section class="results" id="results">
    <div set:html={content.results.replace(/\n/g, '<br/>')} />
  </section>

  <!-- BibTeX Section -->
  <section class="bibtex" id="bibtex">
    <h2>{content.bibtexTitle}</h2>
    <pre class="bibtex-block"><code>{PAPER.bibtex}</code></pre>
    <button
      class="copy-btn"
      onclick={`navigator.clipboard.writeText(${JSON.stringify(PAPER.bibtex)}); this.textContent='${content.copiedButton}'; setTimeout(() => this.textContent='${content.copyButton}', 2000)`}
    >
      {content.copyButton}
    </button>
  </section>

  <!-- Links Section -->
  <section class="links" id="links">
    <h2>{content.linksTitle}</h2>
    <div class="link-grid">
      <a href={`https://arxiv.org/abs/${PAPER.arxivId}`} class="link-card" target="_blank" rel="noopener">
        <span class="link-label">{content.arxivLabel}</span>
        <span class="link-value">{PAPER.arxivId}</span>
      </a>
      {PAPER.codeUrl && (
        <a href={PAPER.codeUrl} class="link-card" target="_blank" rel="noopener">
          <span class="link-label">{content.codeLabel}</span>
          <span class="link-value">GitHub</span>
        </a>
      )}
      {PAPER.projectUrl && (
        <a href={PAPER.projectUrl} class="link-card" target="_blank" rel="noopener">
          <span class="link-label">{content.projectLabel}</span>
          <span class="link-value">{new URL(PAPER.projectUrl).hostname}</span>
        </a>
      )}
    </div>
  </section>
</Layout>

<style>
  @theme {
    --color-primary: oklch(55% 0.15 255);
    --color-accent: oklch(65% 0.18 30);
    --color-bg: oklch(96% 0.01 95);
    --color-surface: oklch(100% 0 0);
    --color-text: oklch(25% 0.02 260);
    --color-text-secondary: oklch(50% 0.02 260);
    --color-border: oklch(85% 0.01 260);
  }

  .hero {
    text-align: center;
    padding: 3rem 1rem 2rem;
  }

  .venue-badge {
    display: inline-block;
    background: var(--color-primary);
    color: white;
    padding: 0.35rem 1rem;
    border-radius: 9999px;
    font-size: 0.875rem;
    font-weight: 600;
    margin-bottom: 1rem;
  }

  .paper-title {
    font-size: clamp(1.5rem, 4vw, 2.5rem);
    font-weight: 700;
    line-height: 1.2;
    margin: 0 0 1.5rem;
    color: var(--color-text);
  }

  .authors {
    display: flex;
    flex-wrap: wrap;
    justify-content: center;
    gap: 0.25rem;
    margin-bottom: 0.5rem;
  }

  .author a {
    color: var(--color-primary);
    text-decoration: none;
  }

  .author a:hover {
    text-decoration: underline;
  }

  .corresponding {
    color: var(--color-accent);
  }

  .affiliations {
    font-size: 0.875rem;
    color: var(--color-text-secondary);
    margin-bottom: 2rem;
  }

  .teaser-image {
    width: 100%;
    max-width: 1200px;
    height: auto;
    border-radius: 0.5rem;
    margin: 0 auto;
  }

  section {
    max-width: 900px;
    margin: 0 auto;
    padding: 2rem 1rem;
  }

  h2 {
    font-size: 1.5rem;
    font-weight: 600;
    margin-bottom: 1rem;
    color: var(--color-text);
  }

  .bibtex-block {
    background: var(--color-surface);
    border: 1px solid var(--color-border);
    border-radius: 0.5rem;
    padding: 1rem;
    overflow-x: auto;
    font-size: 0.8125rem;
    line-height: 1.5;
  }

  .copy-btn {
    margin-top: 0.75rem;
    padding: 0.5rem 1.25rem;
    background: var(--color-primary);
    color: white;
    border: none;
    border-radius: 0.375rem;
    cursor: pointer;
    font-size: 0.875rem;
    transition: opacity 0.2s;
  }

  .copy-btn:hover {
    opacity: 0.9;
  }

  .link-grid {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(200px, 1fr));
    gap: 1rem;
  }

  .link-card {
    display: flex;
    flex-direction: column;
    padding: 1rem;
    border: 1px solid var(--color-border);
    border-radius: 0.5rem;
    text-decoration: none;
    transition: border-color 0.2s, box-shadow 0.2s;
  }

  .link-card:hover {
    border-color: var(--color-primary);
    box-shadow: 0 2px 8px oklch(55% 0.15 255 / 0.1);
  }

  .link-label {
    font-size: 0.75rem;
    text-transform: uppercase;
    letter-spacing: 0.05em;
    color: var(--color-text-secondary);
    margin-bottom: 0.25rem;
  }

  .link-value {
    font-weight: 600;
    color: var(--color-primary);
  }
</style>
