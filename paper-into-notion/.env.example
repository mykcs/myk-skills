# === Notion 凭证 ===
# 走 ntn CLI + macOS keychain, **不需要在 .env 写 token**
# (per weekly-report-phd v1.0 §C.3 + ntn 0.18.1 OAuth, 跟 weekly-report-phd 同)

# === Notion API ===
# Notion-Version header (per ntn 0.18.1 OpenAPI, 旧 database query 已废)
export NOTION_VERSION="2026-03-11"

# === Database / Data Source ID ===
# 论文 database (per plan §实测数据) — 默认配置
# 切换到 信息 db: 改成 39dfedee-6267-80de-9363-ff13b4404a50 + 39dfedee-6267-807a-bcb2-000ba858dff2
export NOTION_DATABASE_ID="398fedee-6267-808f-afc7-d9b3cc2d43f1"
export NOTION_DATA_SOURCE_ID="398fedee-6267-80d6-92e5-000b54d8821e"

# === Property name overrides (v2.5 多 db schema 适配, per user 2026-07-14 拍板 A 方案) ===
# 论文 wiki: 页面 / 信息: 名称 / 其他 db 自定义
export NOTION_TITLE_PROPERTY="页面"
export NOTION_STATUS_DEFAULT="初抓取"
export NOTION_LINK_PROPERTY="link"
export NOTION_ORG_PROPERTY="机构"
# v2.9 (per user 2026-07-14 改 schema): 旧 教育类型 multi_select 改成 展现形式 select
export NOTION_MODAL_PROPERTY="平台"           # 实际存 URL 平台 (arXiv/bilibili/微信公众号/...)
export NOTION_FORM_PROPERTY="展现形式"         # 内容形态 (课程/论文/工具/基础知识/博客/帖子)

# === arXiv API rate limit ===
# 1 req / 3s (per arxiv.org/api 官方约束, 实测 1706.03762 等)
export ARXIV_RATE_LIMIT_SEC=3

# === 验证命令 ===
# bash ~/.agents/skills/paper-into-notion/scripts/paper-into-notion.sh --verify
