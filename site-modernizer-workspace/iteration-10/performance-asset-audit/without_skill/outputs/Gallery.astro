---
import { Image } from 'astro:assets';
import hero from '../assets/hero.png';
---

<div class="gallery">
  <Image src={hero} width={800} height={600} alt="Hero" loading="eager" fetchpriority="high" densities={[1, 2]} />
  <Image src={hero} width={400} height={300} alt="Thumb 1" loading="eager" densities={[1, 2]} />
  <Image src={hero} width={400} height={300} alt="Thumb 2" loading="eager" densities={[1, 2]} />
  <Image src={hero} width={400} height={300} alt="Thumb 3" loading="eager" densities={[1, 2]} />
</div>
